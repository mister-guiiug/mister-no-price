{
  "name": "mister-no-price",
  "version": "1.3.0",
  "private": true,
  "description": "Extension Firefox qui masque les prix sur Amazon et 16 autres boutiques.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "web-ext run --source-dir extension --start-url https://www.amazon.fr",
    "lint": "web-ext lint --source-dir extension",
    "build": "web-ext build --source-dir extension --artifacts-dir web-ext-artifacts --filename \"mister-no-price-{version}.zip\" --overwrite-dest",
    "paquet": "node scripts/paquet.mjs",
    "test": "node --test",
    "verifier": "node scripts/verifier.mjs",
    "verifier:mise-a-jour": "node scripts/verifier-mise-a-jour.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "web-ext": "^10.8.0"
  }
}
